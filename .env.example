# =====================================================================
# TrustPass — environment template. Copy to backend/.env for local runs.
# NEVER commit a real .env or real keys. Demo keys only, ever.
# =====================================================================

# ---------- Backend core ----------
# SQLite by default; switch to PostgreSQL via a standard URL
DATABASE_URL=sqlite:///./trustpass.db
# Change for any deployment; dev-only default in code
SECRET_KEY=change-me-in-production
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- LLM (provider-agnostic, OpenAI-compatible) ----------
# Leave ALL THREE empty to run fully on the deterministic keyword/taxonomy
# fallback — the demo works with no API key at all.
# Works with OpenAI, Groq, local Ollama, etc. via BASE_URL + MODEL + API_KEY.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ---------- Extraction ----------
# Optional: path to the tesseract binary for image/scan fallback (Windows
# example: C:\Program Files\Tesseract-OCR\tesseract.exe). Empty = PDFs only.
TESSERACT_CMD=

# ---------- Blockchain ----------
# Local Hardhat node
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Filled after Stage 4 deployment (npx hardhat run scripts/deploy.ts)
CONTRACT_ADDRESS=
# DEMO-ONLY funded key for the local node. Never put a real wallet key here.
DEPLOYER_PRIVATE_KEY=
# Sepolia (P2 — documented only, not built)
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=

# ---------- Frontend (Vite) ----------
# Put this in frontend/.env.local when needed; VITE_ vars are public by design
VITE_API_BASE=http://localhost:8000
