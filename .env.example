# =====================================================================
# Attesta — environment template. Copy to backend/.env for local runs.
# NEVER commit a real .env or real keys. Demo keys only, ever.
# =====================================================================

# ---------- Backend core ----------
# SQLite by default; switch to PostgreSQL via a standard URL
DATABASE_URL=sqlite:///./attesta.db
# Change for any deployment; dev-only default in code
SECRET_KEY=change-me-in-production
# Comma-separated origins allowed by CORS ("*" only for hosted previews)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- LLM (provider-agnostic, OpenAI-compatible) ----------
# Leave ALL THREE empty to run fully on the deterministic keyword/taxonomy
# fallback — the demo works with no API key at all.
# Works with OpenAI, Groq, local Ollama, etc. via BASE_URL + MODEL + API_KEY.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ---------- Extraction ----------
# Optional: path to the tesseract binary for image/scan fallback (Windows
# example: C:\Program Files\Tesseract-OCR\tesseract.exe). Empty = PDFs only.
TESSERACT_CMD=

# ---------- Blockchain ----------
# Local Hardhat node (started automatically by the backend or ./make chain)
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Leave empty to use data/chain.json, written by scripts/deploy.ts
CONTRACT_ADDRESS=
# DEMO-ONLY signing key for the local node. The default below is Hardhat's
# well-known test account #0 — public in every Hardhat install and worthless
# on any real network. Replace only with a funded testnet key for Sepolia.
DEMO_ISSUER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Sepolia (optional, documented only — not part of the offline demo)
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=

# ---------- Uploads ----------
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg

# ---------- Frontend (Vite) ----------
# Put this in frontend/.env.local when needed; VITE_ vars are public by design
VITE_API_BASE=http://localhost:8000
